{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd ../.. && pnpm --filter @kiu/student-portal... install --frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm turbo run build --filter=@kiu/student-portal && pnpm --filter @kiu/student-portal exec vite build --mode vercel",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://kiu-uscas-api.vercel.app/api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
