{
  "name": "@kiu/admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000 --strictPort",
    "dev:lan": "vite --port 3000 --strictPort --host 0.0.0.0 --mode lan",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview --port 3000 --strictPort",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@kiu/shared": "workspace:*",
    "@kiu/ui": "workspace:*",
    "fflate": "0.8.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@kiu/security": "workspace:*",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.8.3",
    "vite": "^6.0.0",
    "vitest": "^3.2.0"
  }
}
