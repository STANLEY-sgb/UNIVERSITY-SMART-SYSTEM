{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd ../.. && pnpm --filter @kiu/reader... install --frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm turbo run build --filter=@kiu/reader",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://kiu-uscas-api.vercel.app/api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
