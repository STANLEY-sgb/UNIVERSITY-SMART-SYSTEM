{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd ../.. && pnpm --filter @kiu/api... install --frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm db:generate && pnpm turbo run build --filter=@kiu/api",
  "functions": {
    "api/[...path].js": {
      "memory": 1024,
      "maxDuration": 30
    }
  }
}
