# KIU-USCAS environment. Copy to .env. NEVER commit real secrets.
# Every value below is a development placeholder.

NODE_ENV=development
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000

# PostgreSQL (docker compose or `pnpm db:dev` embedded instance)
DATABASE_URL=postgresql://kiu:kiu_dev_password@localhost:5432/kiu_uscas?schema=public
# Prisma Migrate needs a non-pooled connection (prisma/schema.prisma `directUrl`). No PgBouncer in
# front of a local Postgres, so this is the same URL — only Supabase deployments differ (see
# deploy/.env.vercel.example).
DIRECT_URL=postgresql://kiu:kiu_dev_password@localhost:5432/kiu_uscas?schema=public

# Redis is optional in dev: the API degrades to PostgreSQL / in-memory when unset.
REDIS_URL=redis://localhost:6379

# JWT access tokens (short-lived). Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=dev-only-change-me-access-secret-0123456789abcdef
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14

# 32-byte key, base64. Encrypts MFA secrets, card/reader secrets at rest (AES-256-GCM).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=ZGV2LW9ubHkta2V5LTAxMjM0NTY3ODktYWJjZGVmLWs=

# 16-byte AES master key for card-key diversification (32 hex chars). DEV PLACEHOLDER - use a KMS/HSM in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
CARD_MASTER_KEY=000102030405060708090a0b0c0d0e0f
# Ed25519 seed (64 hex) signing offline reader manifests. DEV PLACEHOLDER.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CACHE_SIGNING_KEY=a1b2c3d4e5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718293a4b5c6d7e8f90
OFFLINE_CACHE_TTL_MINUTES=30
CARD_VALIDITY_MONTHS=36
ACTIVATION_CODE_TTL_HOURS=72

# Cookies / CORS
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003

# Auth hardening
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# Development-only demo accounts are created by `pnpm db:seed` when true.
SEED_DEMO_ACCOUNTS=true
