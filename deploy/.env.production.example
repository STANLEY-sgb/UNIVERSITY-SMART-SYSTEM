# Copy to .env.production and fill in, or generate all secrets with:  node deploy/gen-secrets.mjs
# NEVER commit the filled-in file. Back it up somewhere safe: losing DATA_ENCRYPTION_KEY makes stored MFA secrets, reader
# secrets and face templates unreadable; losing CARD_MASTER_KEY invalidates every issued AES card.

# Public hostnames (DNS A/AAAA records must point at this server before the first start so certificates can be issued)
ADMIN_HOST=admin.example.org
WALLET_HOST=wallet.example.org
READER_HOST=reader.example.org

# Secrets (gen-secrets.mjs creates strong random values)
POSTGRES_PASSWORD=
JWT_ACCESS_SECRET=
DATA_ENCRYPTION_KEY=
CARD_MASTER_KEY=
CACHE_SIGNING_KEY=

# Policy knobs with safe defaults
OFFLINE_CACHE_TTL_MINUTES=30
CARD_VALIDITY_MONTHS=36
BACKUP_KEEP_DAYS=14
