# Environment variables for the @kiu/api Vercel project (Project Settings -> Environment Variables).
# Set these for "Production" (and "Preview" too if you want preview deployments to work against the
# same Supabase project — or create a second Supabase project for previews).
#
# Generate the secrets with:  node deploy/gen-secrets-vercel.mjs
# NEVER commit the filled-in values anywhere. Losing DATA_ENCRYPTION_KEY makes stored MFA secrets,
# reader secrets and face templates unreadable; losing CARD_MASTER_KEY invalidates every issued card.

NODE_ENV=production
COOKIE_SECURE=true
SEED_DEMO_ACCOUNTS=false
# Empty: the browser only ever talks to the admin/wallet/reader origins, which proxy /api/* to this
# project via each frontend's vercel.json rewrite — so there is no cross-origin request to allow.
CORS_ORIGINS=

# --- Supabase (Project Settings -> Database -> Connection string) ---
# Pooled (PgBouncer, port 6543) -- used for ordinary runtime queries. connection_limit=1 matters:
# each serverless invocation opens its own connection, and Supabase's free-tier pool is small.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require
# Direct (port 5432) -- used only by `prisma migrate deploy` (PgBouncer's transaction mode can't
# run migrations). Run migrations from your own machine, not from inside a Vercel build (see docs).
DIRECT_URL=postgresql://postgres.xxxxxxxxxxxx:[PASSWORD]@aws-0-REGION.supabase.co:5432/postgres?sslmode=require

# --- Secrets (gen-secrets-vercel.mjs generates these) ---
JWT_ACCESS_SECRET=
DATA_ENCRYPTION_KEY=
CARD_MASTER_KEY=
CACHE_SIGNING_KEY=

# --- Policy knobs with safe defaults ---
OFFLINE_CACHE_TTL_MINUTES=30
CARD_VALIDITY_MONTHS=36
